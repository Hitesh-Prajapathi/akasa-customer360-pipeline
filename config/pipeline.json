{
  "input_dir": "DE-Customer360",
  "output_dir": "output",
  "log_file": "logs/pipeline.log",
  "input_sources": [
    "crm_customers.json",
    "orders.csv",
    "support_tickets.xml"
  ],
  "schema_aliases": {
    "customer_id": [
      "cust_id",
      "c_id",
      "cid",
      "client_id",
      "cust_no"
    ],
    "name": [
      "customer_name",
      "full_name"
    ],
    "email": [
      "email_address",
      "email_id",
      "mail"
    ],
    "city": [
      "town",
      "location"
    ],
    "registration_date": [
      "reg_date",
      "signup_date",
      "created_at"
    ],
    "total_orders": [
      "orders",
      "order_count",
      "num_orders"
    ],
    "lifetime_value": [
      "ltv",
      "clv",
      "revenue",
      "total_spend"
    ],
    "last_order_date": [
      "last_purchase_date",
      "last_ordered_at"
    ],
    "support_tickets": [
      "tickets",
      "ticket_count",
      "num_tickets"
    ],
    "last_ticket_date": [
      "last_ticket",
      "last_ticket_at"
    ]
  },
  "sources": {
    "crm_customers.json": {
      "name": "crm",
      "fields": [
        "customer_id",
        "name",
        "email",
        "city",
        "registration_date"
      ],
      "key_fields": [
        "customer_id"
      ],
      "types": {
        "registration_date": "DATE"
      },
      "required": [
        "customer_id",
        "name",
        "email",
        "city",
        "registration_date"
      ]
    },
    "orders.csv": {
      "name": "orders",
      "fields": [
        "customer_id",
        "total_orders",
        "lifetime_value",
        "last_order_date"
      ],
      "key_fields": [
        "customer_id"
      ],
      "types": {
        "total_orders": "INTEGER",
        "lifetime_value": "BIGINT",
        "last_order_date": "DATE"
      },
      "required": [
        "customer_id",
        "total_orders",
        "lifetime_value",
        "last_order_date"
      ],
      "non_negative": [
        "total_orders",
        "lifetime_value"
      ]
    },
    "support_tickets.xml": {
      "name": "support",
      "fields": [
        "customer_id",
        "support_tickets",
        "last_ticket_date"
      ],
      "key_fields": [
        "customer_id"
      ],
      "types": {
        "support_tickets": "INTEGER",
        "last_ticket_date": "DATE"
      },
      "required": [
        "customer_id",
        "support_tickets",
        "last_ticket_date"
      ],
      "non_negative": [
        "support_tickets"
      ],
      "warning_rules": {
        "ticket_date_without_tickets": "TRY_CAST(support_tickets AS INTEGER) = 0 AND last_ticket_date IS NOT NULL"
      }
    }
  },
  "validation": {
    "customer_id_pattern": "^C\\d{4}$",
    "email_check_deliverability": false
  },
  "dedupe_keep": "latest",
  "segments": {
    "gold_above": 100000,
    "silver_from": 50000
  },
  "insights": {
    "top_n": 10,
    "high_support_above": 5
  },
  "warehouse": {
    "enabled": true,
    "db_path": "output/warehouse/customer360.db"
  },
  "stream": {
    "source": "orders.csv",
    "incoming_dir": "incoming/orders",
    "poll_seconds": 5
  }
}